# ==============================================================================
# Hem Joshi Portfolio — Environment Variables Configuration
# ==============================================================================

# Contact Form Email Delivery (Optional)
# If provided, submissions to the contact form will be emailed directly to your inbox via Resend.
# If omitted, the contact form cleanly falls back to a transparent prefilled mailto link
# and notifies the user that API credentials are awaiting configuration.
RESEND_API_KEY=

# The verified email address where form inquiries should be delivered:
CONTACT_RECIPIENT_EMAIL=hemjoshiwork@gmail.com

# Site URL for metadata & sitemap generation:
NEXT_PUBLIC_SITE_URL=https://hemjoshi.vercel.app
